# Copy to backend/.env or set these in your shell / docker-compose.yml.
# No secrets are needed to run ReplayLab.

# Where runs are stored. Default: a replaylab.db file in the backend folder.
REPLAYLAB_DATABASE_URL=sqlite:///./replaylab.db

# Origins allowed to call the API from a browser (comma-separated).
# Not needed with the Vite dev proxy or Docker (same origin).
REPLAYLAB_CORS_ORIGINS=http://localhost:5173

# Largest accepted request body, in bytes.
REPLAYLAB_MAX_REQUEST_BYTES=5242880

# Set to false to hide the "Run" scenario buttons on a public server.
REPLAYLAB_ENABLE_SCENARIO_RUNNER=true

# Frontend only: where the API lives if it is not on the same origin.
# VITE_API_BASE_URL=http://localhost:8000
